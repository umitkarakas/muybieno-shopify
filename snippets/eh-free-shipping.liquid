{%- comment -%}
  Muybieno — sepet ücretsiz kargo bildirimi. Tüm siparişlerde kargo ücretsiz
  olduğu için eşik/ilerleme hesabı yok; sepette ürün varken sabit bilgi gösterilir.
{%- endcomment -%}
{%- if cart != empty and cart.item_count > 0 -%}
  <div class="eh-free-ship eh-free-ship--done">
    <p class="eh-free-ship__msg">🎉 Tüm siparişlerde kargo <strong>ücretsiz</strong></p>
  </div>
  {%- style -%}
    .eh-free-ship {
      margin: 0 0 1.6rem; padding: 1.2rem 1.4rem; border-radius: 12px;
      background: rgba(255,252,247,0.62); border: 1px solid rgba(255,255,255,0.7);
      backdrop-filter: blur(10px);
    }
    .eh-free-ship__msg {
      margin: 0; font-family: "Inter", system-ui, sans-serif;
      font-size: 1.3rem; font-weight: 500; color: #5C3A1E; text-align: center;
    }
    .eh-free-ship__msg strong { font-weight: 700; }
  {%- endstyle -%}
{%- endif -%}
