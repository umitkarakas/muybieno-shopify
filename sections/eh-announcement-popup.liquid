{%- comment -%}
  Muybieno — Duyuru Popup (editörden yönetilebilir widget).
  İlk gelen ziyaretçiye modal duyuru gösterir; kapatınca localStorage ile hatırlanır.

  Özellikler (hepsi editörden yönetilir):
  - Zamanlama: başlangıç / bitiş tarihi (YYYY-MM-DD). Aralık dışındaysa hiç render edilmez (Liquid ile, flash yok).
  - Banner görseli: opsiyonel; yerleşim üstte (stack) veya yanda (side, masaüstü).
  - Bağlantı: buton yazısı + link, yeni sekmede aç, tüm kartı tıklanabilir yap.
  - Gösterim sıklığı (gün): 0 = tek gösterimlik; N = kapatıldıktan sonra N gün gösterme.
  - Kampanya kodu değişince herkese yeniden gösterilir.

  Editörde (request.design_mode) zamanlama + hatırlama devre dışıdır → merchant her zaman önizler.
  Site geneli render: footer-group.json içinde. Popup position:fixed → DOM konumu görsel olarak önemsiz.
{%- endcomment -%}

{%- comment -%} —— Zamanlama kontrolü (sunucu tarafı) —— {%- endcomment -%}
{%- assign schedule_ok = true -%}
{%- unless request.design_mode -%}
  {%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
  {%- if section.settings.start_date != blank -%}
    {%- assign start_s = section.settings.start_date | append: ' 00:00:00' | date: '%s' | plus: 0 -%}
    {%- if start_s > 0 and now_s < start_s -%}{%- assign schedule_ok = false -%}{%- endif -%}
  {%- endif -%}
  {%- if section.settings.end_date != blank -%}
    {%- assign end_s = section.settings.end_date | append: ' 23:59:59' | date: '%s' | plus: 0 -%}
    {%- if end_s > 0 and now_s > end_s -%}{%- assign schedule_ok = false -%}{%- endif -%}
  {%- endif -%}
{%- endunless -%}

{%- if section.settings.enabled and section.settings.heading != blank and schedule_ok -%}
  {%- assign key = section.settings.campaign_key | default: 'duyuru' | handle -%}
  {%- assign has_link = false -%}
  {%- if section.settings.button_link != blank -%}{%- assign has_link = true -%}{%- endif -%}
  {%- assign card_class = 'eh-annc__card' -%}
  {%- if section.settings.image != blank and section.settings.image_layout == 'side' -%}
    {%- assign card_class = 'eh-annc__card eh-annc__card--side' -%}
  {%- endif -%}
  {%- if section.settings.whole_clickable and has_link -%}{%- assign card_class = card_class | append: ' eh-annc__card--click' -%}{%- endif -%}

  <div
    id="eh-annc-{{ section.id }}"
    class="eh-annc"
    data-key="{{ key }}"
    data-freq="{{ section.settings.frequency_days }}"
    data-delay="{{ section.settings.delay }}"
    data-design="{% if request.design_mode %}true{% else %}false{% endif %}"
    {% if section.settings.whole_clickable and has_link %}data-click-url="{{ section.settings.button_link }}"{% if section.settings.open_new_tab %} data-click-blank="true"{% endif %}{% endif %}
    role="dialog"
    aria-modal="true"
    aria-labelledby="eh-annc-title-{{ section.id }}"
    hidden
  >
    <div class="{{ card_class }}" role="document">
      <button type="button" class="eh-annc__close" data-annc-close aria-label="{{ 'accessibility.close' | t | default: 'Kapat' }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      {%- if section.settings.image != blank -%}
        <div class="eh-annc__media">
          {{ section.settings.image | image_url: width: 900 | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900',
            sizes: '(max-width: 559px) 92vw, 460px',
            alt: section.settings.heading | escape
          }}
        </div>
      {%- endif -%}

      <div class="eh-annc__body">
        {%- if section.settings.badge != blank -%}
          <span class="eh-annc__badge">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h2 id="eh-annc-title-{{ section.id }}" class="eh-annc__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="eh-annc__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and has_link -%}
          <a class="eh-annc__cta" href="{{ section.settings.button_link }}"{% if section.settings.open_new_tab %} target="_blank" rel="noopener"{% endif %}>
            {{ section.settings.button_label }}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.dismiss_label != blank -%}
          <button type="button" class="eh-annc__dismiss" data-annc-close>{{ section.settings.dismiss_label }}</button>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- style -%}
    .eh-annc {
      position: fixed; inset: 0; z-index: 90;
      display: none; align-items: center; justify-content: center;
      padding: 2rem;
      background: rgba(42, 27, 14, 0.55);
      -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      opacity: 0; transition: opacity .28s ease;
    }
    .eh-annc.is-open { display: flex; opacity: 1; }
    html.eh-annc-lock { overflow: hidden; }

    .eh-annc__card {
      position: relative; width: 100%; max-width: 46rem;
      background: rgba(255, 252, 247, 0.97);
      -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.72);
      border-radius: 2rem; overflow: hidden;
      box-shadow: 0 24px 60px rgba(74, 44, 23, 0.28);
      transform: translateY(12px) scale(.98);
      transition: transform .32s cubic-bezier(.16,1,.3,1);
      max-height: calc(100vh - 4rem); overflow-y: auto;
    }
    .eh-annc.is-open .eh-annc__card { transform: none; }
    .eh-annc__card--click { cursor: pointer; }

    .eh-annc__close {
      position: absolute; top: 1.1rem; right: 1.1rem; z-index: 2;
      width: 3.4rem; height: 3.4rem; border-radius: 50%;
      display: grid; place-items: center; cursor: pointer;
      background: rgba(255, 252, 247, 0.85); color: #5C3A1E;
      border: 1px solid rgba(176, 122, 69, 0.28);
      box-shadow: 0 4px 12px rgba(74, 44, 23, 0.12);
      transition: transform .15s ease, background .15s ease;
    }
    .eh-annc__close:hover { transform: scale(1.06); background: #FFFCF7; }

    .eh-annc__media { width: 100%; aspect-ratio: 16 / 9; background: #F3E7D6; }
    .eh-annc__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .eh-annc__body { padding: 2.6rem 2.4rem 2.4rem; text-align: center; }

    .eh-annc__badge {
      display: inline-block; margin-bottom: 1.2rem;
      padding: .5rem 1.2rem; border-radius: 999px;
      font-family: 'Inter', sans-serif; font-size: 1.15rem; font-weight: 600;
      letter-spacing: .04em; text-transform: uppercase; color: #FBF3E7;
      background: linear-gradient(135deg, #5C3A1E 0%, #8A5A2E 55%, #B07A45 100%);
    }
    .eh-annc__title {
      margin: 0 0 1rem; font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 700; font-size: 2.4rem; line-height: 1.15; color: #2A1B0E;
    }
    .eh-annc__text {
      font-family: 'Inter', sans-serif; font-size: 1.55rem; line-height: 1.55;
      color: #5C3A1E; margin: 0 auto 2rem; max-width: 34rem;
    }
    .eh-annc__text p { margin: 0 0 .8rem; }
    .eh-annc__text p:last-child { margin-bottom: 0; }

    .eh-annc__cta {
      display: inline-flex; align-items: center; gap: .6rem;
      padding: 1.2rem 2.4rem; border-radius: .85rem;
      font-family: 'Inter', sans-serif; font-size: 1.5rem; font-weight: 600;
      color: #FBF3E7; text-decoration: none;
      background: linear-gradient(135deg, #5C3A1E 0%, #8A5A2E 55%, #B07A45 100%);
      box-shadow: 0 12px 28px rgba(74, 44, 23, 0.22);
      transition: transform .15s ease, filter .15s ease;
    }
    .eh-annc__cta:hover { transform: translateY(-2px); filter: brightness(1.06); }
    .eh-annc__cta svg { transition: transform .15s ease; }
    .eh-annc__cta:hover svg { transform: translateX(3px); }

    .eh-annc__dismiss {
      display: block; margin: 1.4rem auto 0; padding: .4rem;
      background: none; border: 0; cursor: pointer;
      font-family: 'Inter', sans-serif; font-size: 1.25rem; color: #9C8773;
      text-decoration: underline; text-underline-offset: 2px;
    }
    .eh-annc__dismiss:hover { color: #5C3A1E; }

    /* Yan yerleşim (masaüstü): görsel solda, içerik sağda */
    @media screen and (min-width: 560px) {
      .eh-annc__card--side { display: flex; align-items: stretch; max-width: 62rem; }
      .eh-annc__card--side .eh-annc__media { width: 42%; aspect-ratio: auto; flex: 0 0 42%; }
      .eh-annc__card--side .eh-annc__body { flex: 1; text-align: left; align-self: center; }
      .eh-annc__card--side .eh-annc__text { margin-left: 0; margin-right: 0; }
    }

    @media screen and (max-width: 559px) {
      .eh-annc { padding: 1.4rem; align-items: flex-end; }
      .eh-annc__card { border-radius: 1.6rem; }
      .eh-annc__body { padding: 2.2rem 1.8rem 2rem; }
      .eh-annc__title { font-size: 2.05rem; }
      .eh-annc__text { font-size: 1.45rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .eh-annc, .eh-annc__card, .eh-annc__cta, .eh-annc__cta svg, .eh-annc__close { transition: none; }
      .eh-annc__card { transform: none; }
    }
  {%- endstyle -%}

  <script>
    (function () {
      var root = document.getElementById('eh-annc-{{ section.id }}');
      if (!root || root.dataset.ehBound) return;
      root.dataset.ehBound = '1';

      var cfg = {
        store: 'eh-announce:' + (root.getAttribute('data-key') || 'duyuru'),
        freq: parseInt(root.getAttribute('data-freq'), 10) || 0,
        delay: (parseInt(root.getAttribute('data-delay'), 10) || 0) * 1000,
        design: root.getAttribute('data-design') === 'true',
        clickUrl: root.getAttribute('data-click-url') || '',
        clickBlank: root.getAttribute('data-click-blank') === 'true'
      };
      var lastFocus = null;

      function seen() {
        if (cfg.design) return false; // editörde her zaman göster
        try {
          var v = localStorage.getItem(cfg.store);
          if (!v) return false;
          if (cfg.freq === 0) return true; // tek gösterimlik
          var last = parseInt(v, 10);
          if (isNaN(last)) return true;
          return (Date.now() - last) < cfg.freq * 86400000;
        } catch (e) { return false; }
      }
      function remember() {
        if (cfg.design) return;
        try { localStorage.setItem(cfg.store, String(Date.now())); } catch (e) {}
      }
      function open() {
        lastFocus = document.activeElement;
        root.hidden = false;
        void root.offsetWidth; // reflow → transition tetiklensin
        root.classList.add('is-open');
        document.documentElement.classList.add('eh-annc-lock');
        document.addEventListener('keydown', onKey);
        var f = root.querySelector('.eh-annc__close');
        if (f) f.focus();
      }
      function close() {
        root.classList.remove('is-open');
        document.documentElement.classList.remove('eh-annc-lock');
        document.removeEventListener('keydown', onKey);
        remember();
        window.setTimeout(function () { root.hidden = true; }, 300);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      function onKey(e) {
        if (e.key === 'Escape') { close(); return; }
        if (e.key !== 'Tab') return;
        var f = root.querySelectorAll('a[href], button:not([disabled])');
        if (!f.length) return;
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }

      root.addEventListener('click', function (e) { if (e.target === root) close(); });
      Array.prototype.forEach.call(root.querySelectorAll('[data-annc-close]'), function (b) {
        b.addEventListener('click', function (e) { e.stopPropagation(); close(); });
      });
      var cta = root.querySelector('.eh-annc__cta');
      if (cta) cta.addEventListener('click', remember); // CTA'ya tıklayıp giden de "görmüş" sayılır

      // Tüm kartı tıklanabilir yap
      if (cfg.clickUrl) {
        var card = root.querySelector('.eh-annc__card--click');
        if (card) card.addEventListener('click', function (e) {
          if (e.target.closest('a, button')) return; // buton/link kendi işini yapsın
          remember();
          if (cfg.clickBlank) window.open(cfg.clickUrl, '_blank', 'noopener');
          else window.location.href = cfg.clickUrl;
        });
      }

      if (seen()) return;
      if (cfg.delay > 0) window.setTimeout(open, cfg.delay);
      else open();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Muybieno Duyuru Popup",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Popup'ı göster", "default": true },
    { "type": "header", "content": "İçerik" },
    { "type": "text", "id": "badge", "label": "Üst rozet", "default": "Fırsat" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Muybieno'ya hoş geldiniz" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Taze kavrulmuş tek origin kahvelerimizi keşfedin.</p>" },
    { "type": "header", "content": "Banner görseli" },
    { "type": "image_picker", "id": "image", "label": "Görsel", "info": "Opsiyonel. Boş bırakılırsa yalnızca metin gösterilir." },
    {
      "type": "select", "id": "image_layout", "label": "Görsel yerleşimi", "default": "stack",
      "options": [
        { "value": "stack", "label": "Üstte (16:9)" },
        { "value": "side", "label": "Yanda (masaüstü)" }
      ]
    },
    { "type": "header", "content": "Bağlantı" },
    { "type": "text", "id": "button_label", "label": "Buton yazısı", "default": "Alışverişe başla" },
    { "type": "url", "id": "button_link", "label": "Buton / bağlantı linki" },
    { "type": "checkbox", "id": "open_new_tab", "label": "Yeni sekmede aç", "default": false },
    { "type": "checkbox", "id": "whole_clickable", "label": "Tüm kartı tıklanabilir yap", "default": false, "info": "Kartın herhangi bir yerine tıklamak bağlantıya götürür (buton linki gerekli)." },
    { "type": "text", "id": "dismiss_label", "label": "Kapat linki (opsiyonel)", "default": "Şimdi değil" },
    { "type": "header", "content": "Zamanlama" },
    { "type": "text", "id": "start_date", "label": "Başlangıç tarihi", "info": "Biçim: YYYY-MM-DD (örn. 2026-09-01). Boşsa hemen başlar." },
    { "type": "text", "id": "end_date", "label": "Bitiş tarihi", "info": "Biçim: YYYY-MM-DD. Bu tarihten sonra popup gösterilmez. Boşsa süresiz." },
    { "type": "header", "content": "Gösterim davranışı" },
    {
      "type": "text", "id": "campaign_key", "label": "Kampanya kodu", "default": "hosgeldin-2026",
      "info": "Bu kodu değiştirdiğinizde popup daha önce görmüş olanlar dâhil HERKESE yeniden gösterilir. Yeni bir kampanyada değiştirin."
    },
    {
      "type": "range", "id": "frequency_days", "min": 0, "max": 90, "step": 1, "unit": "gün",
      "label": "Gösterim sıklığı", "default": 0,
      "info": "0 = tek gösterimlik (bir ziyaretçiye yalnızca bir kez). N = kapatıldıktan sonra N gün gösterme, sonra tekrar aç."
    },
    {
      "type": "range", "id": "delay", "min": 0, "max": 15, "step": 1, "unit": "sn",
      "label": "Açılma gecikmesi", "default": 2,
      "info": "Sayfa açıldıktan kaç saniye sonra belirsin."
    }
  ],
  "presets": [ { "name": "Muybieno Duyuru Popup" } ]
}
{% endschema %}
